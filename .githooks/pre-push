#!/usr/bin/env bash
#
# Runs the same checks as CI before anything leaves the machine.
# Enable with: git config core.hooksPath .githooks
#
# Bypass with: git push --no-verify   (only with a good reason)

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

build_dir="${DML_PREPUSH_BUILD_DIR:-build}"
branch="$(git rev-parse --abbrev-ref HEAD)"

if [[ "$branch" == "main" ]]; then
  echo "error: refusing to push directly to main." >&2
  echo "       main holds released versions. Push a feature branch and open a PR." >&2
  exit 1
fi

echo "==> configure ($build_dir)"
cmake -S . -B "$build_dir" -DCMAKE_BUILD_TYPE=Debug -DDML_WARNINGS_AS_ERRORS=ON

echo "==> build"
cmake --build "$build_dir" --parallel

echo "==> check-format"
cmake --build "$build_dir" --target check-format

echo "==> test"
ctest --test-dir "$build_dir" --output-on-failure

echo "==> all checks passed"
